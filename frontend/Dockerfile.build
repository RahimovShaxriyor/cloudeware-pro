FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* pnpm-lock.yaml* ./
RUN npm install -g npm@10 && npm install --legacy-peer-deps || true
RUN if [ -f pnpm-lock.yaml ]; then corepack enable && pnpm install && pnpm rebuild esbuild && pnpm run build; else npm run build; fi
COPY . .
RUN npm run build 2>/dev/null || pnpm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
